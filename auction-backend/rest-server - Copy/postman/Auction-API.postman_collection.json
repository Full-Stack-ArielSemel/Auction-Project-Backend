      "item": [
        {
          "name": "Sign Up - Valid",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sign-up?fullName={{fullName}}&email={{email}}&username={{username}}&password={{password}}&repeatPassword={{password}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sign-up"
              ],
              "query": [
                {
                  "key": "fullName",
                  "value": "{{fullName}}"
                },
                {
                  "key": "email",
                  "value": "{{email}}"
                },
                {
                  "key": "username",
                  "value": "{{username}}"
                },
                {
                  "key": "password",
                  "value": "{{password}}"
                },
                {
                  "key": "repeatPassword",
                  "value": "{{password}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test(\"Sign up succeeds\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Valid",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/login?username={{username}}&password={{password}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ],
              "query": [
                {
                  "key": "username",
                  "value": "{{username}}"
                },
                {
                  "key": "password",
                  "value": "{{password}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Login succeeds\", function () {",
                  "    pm.expect(body.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"Token is returned\", function () {",
                  "    pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"User ID is returned\", function () {",
                  "    pm.expect(body.userId).to.exist;",
                  "});",
                  "",
                  "if (body.token) {",
                  "    pm.collectionVariables.set(\"token\", body.token);",
                  "}",
                  "",
                  "if (body.userId !== undefined && body.userId !== null) {",
                  "    pm.collectionVariables.set(\"userId\", String(body.userId));",
                  "}"
                ]
              }
            }
          ]
        },
